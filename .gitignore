# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Temp files from the atomic write-then-rename in scripts/submit-indexnow.ts and
# scripts/check-indexation.ts. Only ever exist if a run was killed between the
# write and the rename; the state file itself IS committed, the scratch is not.
/data/*.json.tmp
# Same pattern, used by the atomic write in lib/sentences/store.ts.
/data/sentences/**/*.json.tmp

# reports
/reports
/lighthouse-report.html
# Lighthouse CI run output (P2-1) — regenerated per run, never committed
/.lighthouseci/

# ide
.idea
.vscode

# supabase
/supabase/.branches
/supabase/.temp

# misc
/kanji-sheets

package-lock.json

# Tatoeba corpus dumps — fetched by scripts/sentences/, never vendored
.tatoeba-cache/

./engagement-log.csv